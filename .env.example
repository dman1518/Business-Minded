DATABASE_URL="postgresql://businessminded:businessminded@localhost:5432/businessminded?schema=public"

# --- Business Clarity Session (paid offer) ---

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...).
# Server-side only — never exposed to the browser. Without this set,
# the checkout route returns a clear "payments unavailable" response
# instead of failing unpredictably or faking a successful purchase.
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint
# (/api/clarity-session/webhook), shown when the endpoint is created
# in the Stripe Dashboard (or via `stripe listen` locally). Required —
# the webhook route rejects any request it can't verify against this
# secret, since the webhook (not the success-page redirect) is the
# only authoritative signal that a payment succeeded.
STRIPE_WEBHOOK_SECRET=

# External scheduling link shown to verified paying customers after
# intake (e.g. a Calendly/Cal.com booking page). Placeholder until a
# scheduling provider is chosen — see PRODUCT_OWNER_DECISIONS.md.
CLARITY_SESSION_SCHEDULING_URL=

# Resend API key for transactional email (purchase receipt, intake
# reminder, internal new-client alert). Leave unset to run without
# email — the app remains fully usable and resumable without it; see
# PRODUCT_OWNER_DECISIONS.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret protecting the internal fulfillment view
# (/internal/clarity-fulfillment) in the absence of a real admin/auth
# system in this codebase. Generate a long random value; anyone with
# this value can view customer intake answers and purchase data, so
# treat it like a password and never commit it. See
# PRODUCT_OWNER_DECISIONS.md for why this is a stopgap, not a
# permanent access-control design.
CLARITY_ADMIN_SHARED_SECRET=
