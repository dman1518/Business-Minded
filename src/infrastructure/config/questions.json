    {
      "id": "money_1",
      "categoryId": "money",
      "order": 1,
      "type": "single-select",
      "text": "Is your profit margin strong enough to reinvest in the business and pay yourself well?",
      "helpText": "Think about the last few months, not just a single good or bad one.",
      "options": [
        { "value": 1, "label": "No, not really" },
        { "value": 2, "label": "Somewhat, but it's tight" },
        { "value": 3, "label": "It's okay" },
        { "value": 4, "label": "Yes, mostly" },
        { "value": 5, "label": "Yes, consistently" }
      ]
    },
    {
      "id": "money_2",
      "categoryId": "money",
      "order": 2,
      "type": "single-select",
      "text": "Do you have revenue you can count on next month, not just this month?",
      "options": [
        { "value": 1, "label": "No, every month starts from zero" },
        { "value": 2, "label": "A little, but it's unpredictable" },
        { "value": 3, "label": "Somewhat predictable" },
        { "value": 4, "label": "Mostly predictable" },
        { "value": 5, "label": "Yes, highly predictable" }
      ]
    },
    {
      "id": "operations_1",
      "categoryId": "operations",
      "order": 3,
      "type": "single-select",
      "text": "Are your key processes documented well enough that someone new could follow them?",
      "options": [
        { "value": 1, "label": "No, it's all in my head" },
        { "value": 2, "label": "A little, informally" },
        { "value": 3, "label": "Some processes are documented" },
        { "value": 4, "label": "Most are documented" },
        { "value": 5, "label": "Yes, thoroughly documented" }
      ]
    },
    {
      "id": "operations_2",
      "categoryId": "operations",
      "order": 4,
      "type": "single-select",
      "text": "Does the quality of your product or service stay consistent no matter who's doing the work?",
      "options": [
        { "value": 1, "label": "No, it varies a lot" },
        { "value": 2, "label": "It varies somewhat" },
        { "value": 3, "label": "Mostly consistent" },
        { "value": 4, "label": "Consistent" },
        { "value": 5, "label": "Very consistent" }
      ]
    },
    {
      "id": "growth_1",
      "categoryId": "growth",
      "order": 5,
      "type": "single-select",
      "text": "Do you have a clear, repeatable way to bring in new customers?",
      "options": [
        { "value": 1, "label": "No, it's random or word-of-mouth only" },
        { "value": 2, "label": "Somewhat, but inconsistent" },
        { "value": 3, "label": "We have something that works sometimes" },
        { "value": 4, "label": "Yes, a process that mostly works" },
        { "value": 5, "label": "Yes, a reliable, repeatable process" }
      ]
    },
    {
      "id": "growth_2",
      "categoryId": "growth",
      "order": 6,
      "type": "single-select",
      "text": "Is demand for what you sell growing, not flat or shrinking?",
      "options": [
        { "value": 1, "label": "No, demand is shrinking" },
        { "value": 2, "label": "Flat" },
        { "value": 3, "label": "Growing slowly" },
        { "value": 4, "label": "Growing steadily" },
        { "value": 5, "label": "Growing quickly" }
      ]
    },
    {
      "id": "freedom_1",
      "categoryId": "freedom",
      "order": 7,
      "type": "single-select",
      "text": "Could you step away for two weeks without the business suffering?",
      "options": [
        { "value": 1, "label": "No, it would fall apart" },
        { "value": 2, "label": "It would struggle" },
        { "value": 3, "label": "It would be okay, with some issues" },
        { "value": 4, "label": "Yes, mostly fine" },
        { "value": 5, "label": "Yes, it would run smoothly" }
      ]
    },
    {
      "id": "freedom_2",
      "categoryId": "freedom",
      "order": 8,
      "type": "single-select",
      "text": "Do your key customer and vendor relationships avoid depending on you personally?",
      "options": [
        { "value": 1, "label": "No, they all go through me" },
        { "value": 2, "label": "Mostly through me" },
        { "value": 3, "label": "A mix" },
        { "value": 4, "label": "Mostly independent of me" },
        { "value": 5, "label": "Yes, fully independent of me" }
      ]
    },
    {
      "id": "resilience_1",
      "categoryId": "resilience",
      "order": 9,
      "type": "single-select",
      "text": "Could you absorb a serious setback (losing a client, an economic downturn, a key employee leaving) without being in real trouble?",
      "options": [
        { "value": 1, "label": "No, it would be a crisis" },
        { "value": 2, "label": "It would hurt badly" },
        { "value": 3, "label": "We'd manage, with difficulty" },
        { "value": 4, "label": "We'd be okay" },
        { "value": 5, "label": "Yes, we're well prepared" }
      ]
    },
    {
      "id": "resilience_2",
      "categoryId": "resilience",
      "order": 10,
      "type": "single-select",
      "text": "Do you have a cash reserve or safety net that would cover at least a few months of expenses?",
      "options": [
        { "value": 1, "label": "No reserve at all" },
        { "value": 2, "label": "Less than a month" },
        { "value": 3, "label": "About a month or two" },
        { "value": 4, "label": "A few months" },
        { "value": 5, "label": "Several months or more" }
      ]
    }
  ]
